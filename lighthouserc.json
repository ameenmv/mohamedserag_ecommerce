{
  "ci": {
    "collect": {
      "url": [
        "https://localhost:8443/",
        "https://localhost:8443/c/refrigerators",
        "https://localhost:8443/p/fresh-cooker-4b-s15",
        "https://localhost:8443/checkout"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--ignore-certificate-errors",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 375,
          "height": 812,
          "deviceScaleFactor": 2
        },
        "disableStorageReset": true
      },
      "puppeteerScript": "./lighthouse/add-to-cart.cjs",
      "puppeteerLaunchOptions": {
        "args": [
          "--ignore-certificate-errors"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "errors-in-console": [
              "error",
              {
                "maxLength": 0
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^https://localhost:8443/$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 204800
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "https://localhost:8443/(c|p|checkout).*",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
