{
  "name": "serag",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @serag/e2e exec e2e run",
    "db:up": "docker compose -f docker/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker/compose.dev.yml down",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:generate && pnpm db:seed",
    "db:migrate": "pnpm --filter @serag/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @serag/api exec prisma generate",
    "db:seed": "pnpm --filter @serag/shared build && pnpm --filter @serag/api exec prisma db seed",
    "db:studio": "pnpm --filter @serag/api exec prisma studio",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
