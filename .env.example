# Database (dev compose: docker/compose.dev.yml)
DATABASE_URL=postgresql://serag:serag@localhost:5432/serag
TEST_DATABASE_URL=postgresql://serag:serag@localhost:5433/serag_test

# API
API_PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000

# First admin user (seed)
ADMIN_EMAIL=admin@serag.local
ADMIN_PASSWORD=change-me

# Web
NUXT_PUBLIC_API_BASE=http://localhost:4000/api
NUXT_API_INTERNAL_BASE=http://localhost:4000/api

# E2E test seed (only in compose.e2e.yml / local e2e)
ALLOW_TEST_SEED=false
TEST_SEED_SECRET=dev-only-test-seed-secret-change-me

# Analytics (Umami)
NUXT_PUBLIC_UMAMI_HOST=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

# SEO: public origin for canonical URLs, sitemap, robots.txt and JSON-LD (web), and feed links (API)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
# 'true' only on the production origin; otherwise robots.txt disallows everything
NUXT_PUBLIC_SITE_INDEXABLE=false
