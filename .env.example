# Database (dev compose: docker/compose.dev.yml)
DATABASE_URL=postgresql://serag:serag@localhost:5432/serag
TEST_DATABASE_URL=postgresql://serag:serag@localhost:5433/serag_test

# API
API_PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
WEB_ORIGIN=http://localhost:3000

# First admin user (seed)
ADMIN_EMAIL=admin@serag.local
ADMIN_PASSWORD=change-me

# Web
NUXT_PUBLIC_API_BASE=http://localhost:4000/api
NUXT_API_INTERNAL_BASE=http://localhost:4000/api

# E2E test seed (only in compose.e2e.yml / local e2e)
ALLOW_TEST_SEED=false
TEST_SEED_SECRET=change-me

# Analytics (Umami)
NUXT_PUBLIC_UMAMI_HOST=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
