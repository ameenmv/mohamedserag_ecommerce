# Used only by the Lighthouse CI job to mirror production serving.
{
	auto_https disable_redirects
	http_port 8080
}

https://localhost:8443 {
	tls internal
	encode zstd gzip

	# Same origin for the API, as in docker/Caddyfile: the browser's cart quote is not cross-origin.
	handle /api/* {
		reverse_proxy localhost:4000
	}

	# A web server started for Lighthouse whose public API base is this origin (see ci.yml).
	handle {
		reverse_proxy localhost:3001
	}
}
