# Copy to docker/.env on the server and fill in. Never commit docker/.env. See docs/DEPLOY.md §2.
SITE_ADDRESS=serag-store.com
PUBLIC_URL=https://serag-store.com
SITE_INDEXABLE=true

POSTGRES_USER=serag
# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -base64 48
SESSION_SECRET=
# openssl rand -base64 32
UMAMI_SECRET=
# From the Umami dashboard after the first deploy (docs/DEPLOY.md §4)
UMAMI_WEBSITE_ID=

# First admin user, used by the one-off seed
ADMIN_EMAIL=
ADMIN_PASSWORD=

BACKUP_RETENTION_DAYS=30

# Off-site backups to Cloudflare R2 (leave empty to keep backups on the server only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_BACKUPS=
OFFSITE_RETENTION_DAYS=14

# Error tracking with Sentry (leave empty to turn it off). One project per app, from sentry.io.
SENTRY_DSN_API=
SENTRY_DSN_WEB=
# Version shown in error reports: GIT_SHA=$(git rev-parse --short HEAD) before `docker compose up`
GIT_SHA=
